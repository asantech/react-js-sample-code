    "@types/jest": "^30.0.0",
    "autoprefixer": "^10.4.21",
    "chai": "^5.2.0",
    "cypress": "^14.5.0",
    "jest": "^30.0.4",
    "jest-axe": "^10.0.0",
    "mocha": "^11.7.1",
    "msw": "^2.10.2",
    "nock": "^14.0.5",
